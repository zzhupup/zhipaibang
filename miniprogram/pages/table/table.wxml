<view class="page">
  <!-- 顶栏 -->
  <view class="hdr">
    <view class="hdrRow">
      <view class="tally">
        <text class="tallyLbl">金库</text>
        <view wx:for="{{vaultCards}}" wx:key="index" class="miniCard {{item?'gold':''}}"></view>
        <text class="tallyLbl alarmLbl">警报</text>
        <view wx:for="{{alarmCards}}" wx:key="index" class="miniCard {{item?'red':''}}"></view>
      </view>
      <view class="hdrBtns">
        <button class="hbtn" catchtap="onInfo">🎯</button>
        <button class="hbtn" catchtap="onLog">📜</button>
        <button class="hbtn" catchtap="onRules">📖</button>
        <button class="hbtn" catchtap="onRestart">✖</button>
      </view>
    </view>
    <view class="hdrRow2">
      <view class="pill" catchtap="onInfo">第{{heist}}次劫案 · {{pillText}}</view>
      <view wx:if="{{challengeName}}" class="pill challenge" catchtap="onInfo">🃏{{challengeName}}</view>
      <view wx:if="{{expertName}}" class="pill expert" catchtap="onInfo">👔{{expertName}}</view>
    </view>
  </view>

  <!-- 模板：单张完整卡面（弹窗用，f.hl=金边高亮）经典样式：角标+中央点阵/人头 -->
  <template name="tCard">
    <view class="pcard small {{f.red?'red':''}} {{f.knight?'knight':''}} {{f.hl?'hl2':''}}">
      <view class="corner"><text class="rg">{{f.label}}</text><text class="st">{{f.suit}}</text></view>
      <view wx:if="{{f.court}}" class="courtBox">
        <view class="courtArt rank-{{f.label}}">
          <view wx:if="{{f.label==='K'}}" class="crown"></view>
          <view wx:if="{{f.label==='Q'}}" class="hair"></view>
          <view wx:if="{{f.label==='J'}}" class="hat"></view>
          <view class="head"></view>
          <view wx:if="{{f.label==='K'}}" class="beard"></view>
          <view class="robe"></view>
          <text class="chest">{{f.suit}}</text>
        </view>
      </view>
      <view wx:else class="pipsArea {{f.ace?'ace':''}}">
        <text wx:for="{{f.pips}}" wx:for-item="pp" wx:key="index" class="pipI {{pp.f?'fl':''}}" style="left:{{pp.x}}%;top:{{pp.y}}%">{{f.suit}}</text>
      </view>
      <view class="corner br"><text class="rg">{{f.label}}</text><text class="st">{{f.suit}}</text></view>
    </view>
  </template>

  <!-- 模板：超小牌（摊牌结果板用） -->
  <template name="tCardT">
    <view class="pcard tiny {{f.red?'red':''}} {{f.knight?'knight':''}} {{f.hl?'hl2':''}}">
      <view class="corner"><text class="rg">{{f.label}}</text><text class="st">{{f.suit}}</text></view>
      <view wx:if="{{f.court}}" class="courtBox">
        <view class="courtArt rank-{{f.label}}">
          <view wx:if="{{f.label==='K'}}" class="crown"></view>
          <view wx:if="{{f.label==='Q'}}" class="hair"></view>
          <view wx:if="{{f.label==='J'}}" class="hat"></view>
          <view class="head"></view>
          <view wx:if="{{f.label==='K'}}" class="beard"></view>
          <view class="robe"></view>
          <text class="chest">{{f.suit}}</text>
        </view>
      </view>
      <view wx:else class="pipsArea {{f.ace?'ace':''}}">
        <text wx:for="{{f.pips}}" wx:for-item="pp" wx:key="index" class="pipI {{pp.f?'fl':''}}" style="left:{{pp.x}}%;top:{{pp.y}}%">{{f.suit}}</text>
      </view>
      <view class="corner br"><text class="rg">{{f.label}}</text><text class="st">{{f.suit}}</text></view>
    </view>
  </template>

  <!-- 模板：中央区（公共牌 + 牌堆 + 中央筹码） -->
  <template name="tCenter">
    <view class="communityRow">
      <block wx:for="{{communityViews}}" wx:key="index">
        <view wx:if="{{item.face}}" class="pcard small {{item.face.red?'red':''}} {{item.face.knight?'knight':''}}">
          <view class="corner"><text class="rg">{{item.face.label}}</text><text class="st">{{item.face.suit}}</text></view>
          <view wx:if="{{item.face.court}}" class="courtBox">
            <view class="courtArt rank-{{item.face.label}}">
              <view wx:if="{{item.face.label==='K'}}" class="crown"></view>
              <view wx:if="{{item.face.label==='Q'}}" class="hair"></view>
              <view wx:if="{{item.face.label==='J'}}" class="hat"></view>
              <view class="head"></view>
              <view wx:if="{{item.face.label==='K'}}" class="beard"></view>
              <view class="robe"></view>
              <text class="chest">{{item.face.suit}}</text>
            </view>
          </view>
          <view wx:else class="pipsArea {{item.face.ace?'ace':''}}">
            <text wx:for="{{item.face.pips}}" wx:for-item="pp" wx:key="index" class="pipI {{pp.f?'fl':''}}" style="left:{{pp.x}}%;top:{{pp.y}}%">{{item.face.suit}}</text>
          </view>
          <view class="corner br"><text class="rg">{{item.face.label}}</text><text class="st">{{item.face.suit}}</text></view>
        </view>
        <view wx:else class="slot"><text>公共牌</text></view>
      </block>
    </view>
    <view class="deckRow"><view class="pcard small back"></view><text class="deckTxt">牌堆 {{deckCount}} · 弃牌 {{discardCount}}</text></view>
    <view class="centerChips">
      <view wx:for="{{centerChips}}" wx:key="star" class="chip {{item.colorCls}}" hover-class="chipHover"
        catchtap="onCenterChip" data-star="{{item.star}}">
        <text wx:for="{{item.starPos}}" wx:for-item="st" wx:key="index" class="starDot" style="left:{{st.x}}%;top:{{st.y}}%">★</text>
      </view>
      <text wx:if="{{phase==='chips' && !centerChips.length}}" class="noChip">中央已没有筹码</text>
      <text wx:if="{{phase==='showdown'}}" class="noChip">摊牌进行中…</text>
    </view>
  </template>

  <!-- 模板：座位内部 -->
  <template name="tSeat">
    <view class="seatHead">
      <text class="pname">{{p.name}}</text>
      <view wx:if="{{p.msg}}" class="chatTicker">
        <text class="chatTickerTxt {{p.msg.length > 8 ? 'run' : ''}}"
          style="{{p.msg.length > 8 ? 'animation-duration:' + (p.msg.length * 0.4) + 's' : ''}}">{{p.msg}}</text>
      </view>
      <text wx:if="{{p.striker}}" class="badge">👊</text><text wx:if="{{p.isMe}}" class="badge me">你</text>
    </view>
    <view class="holeRow">
      <block wx:if="{{p.myHole}}">
        <view wx:for="{{p.myHole}}" wx:for-item="hc" wx:key="index" class="pcard tiny {{hc.red?'red':''}} {{hc.knight?'knight':''}} faceUp">
          <view class="corner"><text class="rg">{{hc.label}}</text><text class="st">{{hc.suit}}</text></view>
          <view wx:if="{{hc.court}}" class="courtBox">
            <view class="courtArt rank-{{hc.label}}">
              <view wx:if="{{hc.label==='K'}}" class="crown"></view>
              <view wx:if="{{hc.label==='Q'}}" class="hair"></view>
              <view wx:if="{{hc.label==='J'}}" class="hat"></view>
              <view class="head"></view>
              <view wx:if="{{hc.label==='K'}}" class="beard"></view>
              <view class="robe"></view>
              <text class="chest">{{hc.suit}}</text>
            </view>
          </view>
          <view wx:else class="pipsArea {{hc.ace?'ace':''}}">
            <text wx:for="{{hc.pips}}" wx:for-item="pp" wx:key="index" class="pipI {{pp.f?'fl':''}}" style="left:{{pp.x}}%;top:{{pp.y}}%">{{hc.suit}}</text>
          </view>
          <view class="corner br"><text class="rg">{{hc.label}}</text><text class="st">{{hc.suit}}</text></view>
        </view>
      </block>
      <block wx:else>
        <view wx:for="{{[0,1,2]}}" wx:for-item="h" wx:key="*this" wx:if="{{p.holeCount > index}}" class="pcard tiny back"></view>
      </block>
      <view wx:if="{{p.canPeek}}" class="eye" catchtap="onPeek" data-i="{{p.i}}">👁</view>
    </view>
    <view class="chipLine">
      <block wx:for="{{p.chips}}" wx:for-item="ch" wx:key="id">
        <view class="chip mini {{ch.colorCls}} {{ch.dark?'dark':''}} {{ch.current?'takable':''}}"
          catchtap="onSeatChip" data-i="{{p.i}}">
          <text wx:for="{{ch.starPos}}" wx:for-item="st" wx:key="index" class="starDot" style="left:{{st.x}}%;top:{{st.y}}%">★</text>
        </view>
      </block>
      <text wx:if="{{!p.chips.length}}" class="rl">暂无筹码</text>
    </view>
    <view wx:if="{{phase==='chips'}}" class="actionRow">
      <button wx:if="{{p.canReturn}}" class="returnBtn" catchtap="onReturn" data-i="{{p.i}}">↩ 撤回</button>
      <button class="confirmBtn {{p.confirmed?'on':''}} {{p.canConfirm?'':'dis'}}"
        catchtap="onConfirm" data-i="{{p.i}}">{{p.confirmLabel}}</button>
    </view>
    <text wx:if="{{p.myInfo}}" class="msg myInfo">{{p.myInfo}}</text>
  </template>

  <!-- ============ 宽屏：圆桌舞台 ============ -->
  <block wx:if="{{layout==='round'}}">
    <view class="stageWrap" style="width:{{stageW}}px;height:{{stageH}}px">
      <view class="stage" style="width:{{stageW}}px;height:{{stageH}}px;transform:scale({{scale}})">
        <view class="roundTable"><view class="feltMark">筹 码 密 语</view></view>
        <view class="centerArea">
          <template is="tCenter" data="{{communityViews, deckCount, discardCount, centerChips, phase, round}}"/>
        </view>
        <view class="seat" wx:for="{{seats}}" wx:key="i" style="left:{{item.x}}px;top:{{item.y}}px">
          <template is="tSeat" data="{{p:item, phase}}"/>
        </view>
      </view>
    </view>
  </block>

  <!-- ============ 手机竖屏：毛毡面板 + 座位网格 ============ -->
  <block wx:else>
    <scroll-view scroll-y class="stackScroll">
      <view class="feltPanel">
        <view class="feltMarkM">筹 码 密 语</view>
        <template is="tCenter" data="{{communityViews, deckCount, discardCount, centerChips, phase, round}}"/>
      </view>
      <view class="seatGrid">
        <view class="seatM {{item.isMe?'me':''}}" wx:for="{{seats}}" wx:key="i">
          <template is="tSeat" data="{{p:item, phase}}"/>
        </view>
      </view>
      <view class="stackFoot"></view>
    </scroll-view>
  </block>
</view>

<!-- 模态弹窗（单机/房主引擎弹窗 · 客人查看底牌） -->
<view class="mroot {{modal?'show':''}}">
  <view class="mbox" wx:if="{{modal}}" catchtap="noop">
    <view class="mtitle {{modal.titleCls}}">{{modal.title}}</view>
    <!-- 完整卡面（看底牌/换新牌/王牌等） -->
    <view wx:if="{{modal.cards}}" class="mcards">
      <template wx:for="{{modal.cards}}" wx:key="index" is="tCard" data="{{f:item}}"/>
    </view>
    <!-- 摊牌：底牌 + 公共牌（金边=参与比较） -->
    <view wx:if="{{modal.reveal}}" class="mreveal">
      <view class="rlbl">底牌：</view>
      <view class="mcards">
        <template wx:for="{{modal.reveal.holeFaces}}" wx:key="index" is="tCard" data="{{f:item}}"/>
      </view>
      <view class="rlbl">公共牌：</view>
      <view class="mcards">
        <template wx:for="{{modal.reveal.communityFaces}}" wx:key="index" is="tCard" data="{{f:item}}"/>
      </view>
    </view>
    <scroll-view scroll-y class="mbodyS {{modal.cards||modal.reveal?'':'full'}}">
      <rich-text nodes="{{modal.body}}"></rich-text>
    </scroll-view>
    <view class="macts">
      <button wx:for="{{modal.actions}}" wx:key="idx" class="mbtn {{item.cls}}"
        catchtap="onModalAction" data-i="{{item.idx}}">{{item.label}}</button>
    </view>
  </view>
</view>

<!-- 客人：公开/私密提示弹窗（声明式） -->
<view class="mroot {{guestModal?'show':''}}">
  <view class="mbox" wx:if="{{guestModal}}" catchtap="noop">
    <view class="mtitle">{{guestModal.title}}</view>
    <view wx:if="{{guestModal.cards}}" class="mcards">
      <template wx:for="{{guestModal.cards}}" wx:key="index" is="tCard" data="{{f:item}}"/>
    </view>
    <view wx:if="{{guestModal.reveal}}" class="mreveal">
      <view class="rlbl">底牌：</view>
      <view class="mcards">
        <template wx:for="{{guestModal.reveal.holeFaces}}" wx:key="index" is="tCard" data="{{f:item}}"/>
      </view>
      <view class="rlbl">公共牌：</view>
      <view class="mcards">
        <template wx:for="{{guestModal.reveal.communityFaces}}" wx:key="index" is="tCard" data="{{f:item}}"/>
      </view>
    </view>
    <scroll-view scroll-y class="mbodyS {{guestModal.cards||guestModal.reveal?'':'full'}}">
      <rich-text nodes="{{guestModal.body}}"></rich-text>
    </scroll-view>
    <view class="macts">
      <button wx:for="{{guestModal.actions}}" wx:key="idx" class="mbtn {{item.cls}}"
        catchtap="onGuestAction" data-i="{{item.idx}}">{{item.label}}</button>
    </view>
  </view>
</view>

<!-- 客人：他人私密操作等待提示 -->
<view class="mroot {{waitModal?'show':''}}">
  <view class="mbox" wx:if="{{waitModal}}" catchtap="noop">
    <view class="mtitle">{{waitModal.title}}</view>
    <scroll-view scroll-y class="mbodyS">
      <rich-text nodes="{{waitModal.body}}"></rich-text>
    </scroll-view>
  </view>
</view>

<!-- 摊牌结果板：全员同屏（三种模式共用），按红筹码星数升序，正确打钩/错误打叉 -->
<view class="mroot {{showdownBoard?'show':''}}" wx:if="{{showdownBoard}}">
  <view class="mbox sdBoard" catchtap="noop">
    <view class="mtitle">🃏 摊牌 — 全员底牌公布</view>
    <view wx:if="{{boardGate}}" class="sdVerdict {{boardGate.fail?'bad':'ok'}}">{{boardGate.fail ? '💥 ' + boardGate.fail : '✅ 全员顺序正确，配合完美！'}}</view>
    <scroll-view scroll-y class="sdList">
      <view wx:for="{{showdownBoard}}" wx:key="seq" class="sdRow">
        <view class="sdHead">
          <view class="sdSeq">{{index + 1}}</view>
          <view class="sdStar">{{item.star}}星</view>
          <view class="sdName">{{item.name}}{{item.striker ? ' 👊' : ''}}<text class="sdHand">{{item.hand}}</text></view>
          <view class="sdMark {{item.ok ? 'ok' : 'bad'}}">{{item.ok ? '✓' : '✗'}}</view>
        </view>
        <view class="sdCardsRow">
          <text class="sdLbl">底牌</text>
          <template wx:for="{{item.holeFaces}}" wx:for-item="f" wx:key="index" is="tCardT" data="{{f}}"/>
        </view>
        <view class="sdCardsRow">
          <text class="sdLbl">公共</text>
          <template wx:for="{{item.communityFaces}}" wx:for-item="f" wx:key="index" is="tCardT" data="{{f}}"/>
        </view>
      </view>
    </scroll-view>
    <view class="sdHint">按红筹码星数升序 · 金边牌为最强五张 · ✓ 顺序正确 ✗ 弱于上一位</view>
    <view class="sdDoneRow">
      <button wx:if="{{playMode !== 'guest'}}" class="sdDone" catchtap="onBoardDone">完 成</button>
      <text wx:else class="sdWait">⏳ 等待房主结算…</text>
    </view>
  </view>
</view>

<!-- 客人：私密选牌弹层 -->
<view class="mroot {{guestPick?'show':''}}">
  <view class="mbox" wx:if="{{guestPick}}" catchtap="noop">
    <view class="mtitle priv">🤫 你的私密操作</view>
    <view class="privWarn">{{guestPick.prompt}}</view>
    <view class="otherWarn">⚠ 其他玩家请移开视线！</view>
    <view class="pickRow">
      <view wx:for="{{guestPick.cards}}" wx:key="idx" class="pcard {{item.face.red?'red':''}} {{item.face.knight?'knight':''}} pickCard"
        catchtap="onGuestPick" data-idx="{{item.idx}}">
        <view class="corner"><text class="rg">{{item.face.label}}</text><text class="st">{{item.face.suit}}</text></view>
        <view wx:if="{{item.face.court}}" class="courtBox">
          <view class="courtArt rank-{{item.face.label}}">
            <view wx:if="{{item.face.label==='K'}}" class="crown"></view>
            <view wx:if="{{item.face.label==='Q'}}" class="hair"></view>
            <view wx:if="{{item.face.label==='J'}}" class="hat"></view>
            <view class="head"></view>
            <view wx:if="{{item.face.label==='K'}}" class="beard"></view>
            <view class="robe"></view>
            <text class="chest">{{item.face.suit}}</text>
          </view>
        </view>
        <view wx:else class="pipsArea {{item.face.ace?'ace':''}}">
          <text wx:for="{{item.face.pips}}" wx:for-item="pp" wx:key="index" class="pipI {{pp.f?'fl':''}}" style="left:{{pp.x}}%;top:{{pp.y}}%">{{item.face.suit}}</text>
        </view>
        <view class="corner br"><text class="rg">{{item.face.label}}</text><text class="st">{{item.face.suit}}</text></view>
      </view>
    </view>
  </view>
</view>

<!-- 客人：查看自己的底牌 -->
<view class="mroot {{peekModal?'show':''}}">
  <view class="mbox" wx:if="{{peekModal}}" catchtap="noop">
    <view class="mtitle priv">{{peekModal.title}}</view>
    <scroll-view scroll-y class="mbodyS">
      <rich-text nodes="{{peekModal.body}}"></rich-text>
    </scroll-view>
    <view class="macts">
      <button class="mbtn" catchtap="closePeek">看完了，隐藏</button>
    </view>
  </view>
</view>

<!-- 游戏内发言：文字显示在自己座位框内 -->
<view class="chatBar {{gameOver ? 'hide' : ''}}">
  <input class="chatInput" value="{{chatText}}" placeholder="说点什么，显示在你的座位框内"
    confirm-type="send" maxlength="60" bindinput="onChatInput" bindconfirm="onChatSend" />
  <button class="chatSend" bindtap="onChatSend">发送</button>
</view>

<!-- 整局结束：再来一局 / 退出房间（联机） -->
<view class="overBar {{gameOver && playMode!=='single' ? 'show' : ''}}">
  <view class="overTitle">🎉 本局游戏结束</view>
  <view class="overBtns">
    <button class="overBtn primary" catchtap="onPlayAgain">🔄 再来一局</button>
    <button class="overBtn ghost" catchtap="onExitRoom">🚪 退出房间</button>
  </view>
</view>

<!-- 私密选底牌弹层 -->
<view class="mroot {{pick?'show':''}}">
  <view class="mbox" wx:if="{{pick}}" catchtap="noop">
    <view class="mtitle priv">{{pick.title}}</view>
    <view class="privWarn">{{pick.prompt}}</view>
    <view class="otherWarn">⚠ 其他玩家请移开视线！</view>
    <view class="pickRow">
      <view wx:for="{{pick.cards}}" wx:key="idx" class="pcard {{item.face.red?'red':''}} {{item.face.knight?'knight':''}} pickCard"
        catchtap="onPickCard" data-idx="{{item.idx}}">
        <view class="corner"><text class="rg">{{item.face.label}}</text><text class="st">{{item.face.suit}}</text></view>
        <view wx:if="{{item.face.court}}" class="courtBox">
          <view class="courtArt rank-{{item.face.label}}">
            <view wx:if="{{item.face.label==='K'}}" class="crown"></view>
            <view wx:if="{{item.face.label==='Q'}}" class="hair"></view>
            <view wx:if="{{item.face.label==='J'}}" class="hat"></view>
            <view class="head"></view>
            <view wx:if="{{item.face.label==='K'}}" class="beard"></view>
            <view class="robe"></view>
            <text class="chest">{{item.face.suit}}</text>
          </view>
        </view>
        <view wx:else class="pipsArea {{item.face.ace?'ace':''}}">
          <text wx:for="{{item.face.pips}}" wx:for-item="pp" wx:key="index" class="pipI {{pp.f?'fl':''}}" style="left:{{pp.x}}%;top:{{pp.y}}%">{{item.face.suit}}</text>
        </view>
        <view class="corner br"><text class="rg">{{item.face.label}}</text><text class="st">{{item.face.suit}}</text></view>
      </view>
    </view>
  </view>
</view>
