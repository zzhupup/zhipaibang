.page { padding: 12rpx; }

/* ---------- 顶栏 ---------- */
.hdr { padding: 4rpx 6rpx 10rpx; }
.hdrRow { display: flex; align-items: center; }
.hdrRow2 { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 10rpx; }
.tally { display: flex; align-items: center; gap: 8rpx; flex: 1; }
.tallyLbl { font-size: 22rpx; color: #bfe3d0; margin-right: 4rpx; }
.alarmLbl { margin-left: 16rpx; }
.miniCard {
  width: 40rpx; height: 56rpx; border-radius: 8rpx;
  background: linear-gradient(135deg, #3a3a3a, #242424);
  border: 3rpx solid #555;
  transition: all .4s;
}
.miniCard.gold { background: linear-gradient(135deg, #f0d060, #c9a227); border-color: #ffe9a0; box-shadow: 0 0 14rpx rgba(232,193,90,.7); }
.miniCard.red { background: linear-gradient(135deg, #e2574f, #a02a24); border-color: #ff9a90; box-shadow: 0 0 14rpx rgba(214,69,65,.7); }
.hdrBtns { display: flex; gap: 10rpx; }
.hbtn {
  background: rgba(255,255,255,.08); border: 2rpx solid #2e7a58;
  color: #cfe8da; font-size: 24rpx; line-height: 1;
  padding: 8rpx 16rpx; border-radius: 10rpx; margin: 0;
}
.hbtn::after { border: none; }
.pill {
  cursor: pointer; font-size: 23rpx; padding: 8rpx 22rpx; border-radius: 30rpx;
  background: rgba(232,193,90,.14); border: 2rpx solid rgba(232,193,90,.5); color: #ffe9b0;
}
.pill.challenge { background: rgba(127,178,255,.12); border-color: rgba(127,178,255,.5); color: #7fb2ff; }
.pill.expert { background: rgba(240,160,232,.12); border-color: rgba(240,160,232,.5); color: #f0a0e8; }

/* ---------- 圆桌舞台 ---------- */
.stageWrap { margin: 0 auto 150rpx; overflow: hidden; }
.stage { position: relative; transform-origin: 0 0; }
.roundTable {
  position: absolute; left: 50%; top: 50%; width: 640px; height: 430px;
  transform: translate(-50%, -50%);
  background: radial-gradient(ellipse at 50% 32%, #2f8a5b, #1d5f3d 62%, #124529);
  border-radius: 50%;
  border: 12px solid #5a3d23;
  box-shadow: inset 0 0 46px rgba(0,0,0,.55), 0 16px 44px rgba(0,0,0,.55), 0 0 0 3px #3d2a18;
}
.roundTable::after {
  content: ""; position: absolute; left: 16px; top: 16px; right: 16px; bottom: 16px;
  border-radius: 50%; border: 2px dashed rgba(255,255,255,.13);
}
.feltMark {
  position: absolute; left: 50%; top: 26px; transform: translateX(-50%);
  color: rgba(255,233,176,.28); font-size: 15px; letter-spacing: 8px; font-weight: bold;
}
.centerArea {
  position: absolute; left: 50%; top: 50%;
  transform: translate(-50%, -50%);
  display: flex; flex-direction: column; align-items: center; gap: 10px; z-index: 5;
}
.communityRow { display: flex; gap: 7px; }
.slot {
  width: 46px; height: 66px; border: 2px dashed rgba(255,255,255,.2);
  border-radius: 7px; display: flex; align-items: center; justify-content: center;
  color: rgba(255,255,255,.28); font-size: 10px; text-align: center;
}
.deckRow { display: flex; gap: 8px; align-items: center; }
.deckTxt { color: #cfe8da; font-size: 11px; }
.centerChips { display: flex; gap: 9px; flex-wrap: wrap; justify-content: center; align-items: center; max-width: 540px; min-height: 42px; }
.noChip { color: #cfe8da; font-size: 12px; }

/* ---------- 扑克牌（经典样式：白底 + 对角角标 + 中央点阵/花框） ---------- */
.pcard {
  width: 46px; height: 66px; background: #fffdf8; color: #1b1b1b;
  border-radius: 6px; box-shadow: 0 3px 8px rgba(0,0,0,.4);
  border: 1px solid rgba(0,0,0,.22); box-sizing: border-box;
  position: relative; font-weight: bold; flex: none; overflow: hidden;
}
.pcard.small { width: 46px; height: 66px; }
.pcard.tiny { width: 34px; height: 48px; }
.pcard .corner {
  position: absolute; top: 3px; left: 4px; z-index: 2;
  text-align: center; display: flex; flex-direction: column; align-items: center;
}
.pcard .corner .rg { font-size: 11px; line-height: 1.02; letter-spacing: -0.5px; }
.pcard .corner .st { font-size: 9px; line-height: 1.05; }
.pcard .corner.br { top: auto; left: auto; bottom: 3px; right: 4px; transform: rotate(180deg); }
/* 中央点阵区（2~10 按真实牌型布点，A 单大点） */
.pcard .pipsArea { position: absolute; left: 25%; right: 25%; top: 9%; bottom: 9%; }
.pcard .pipI { position: absolute; transform: translate(-50%, -50%); font-size: 11px; line-height: 1; }
.pcard .pipI.fl { transform: translate(-50%, -50%) rotate(180deg); }
.pcard .pipsArea.ace .pipI { font-size: 24px; }
/* J/Q/K 中央人头（纯 CSS 胸像：冠/发/帽 + 脸 + 袍 + 胸口花色） */
.pcard .courtBox {
  position: absolute; left: 16%; right: 16%; top: 10%; bottom: 10%;
  border: 1px solid currentColor; border-radius: 4px;
  background: rgba(0,0,0,.03);
  overflow: hidden;
}
.pcard .courtArt { position: absolute; left: 50%; top: 50%; width: 26px; height: 38px; transform: translate(-50%, -50%); }
.pcard .courtArt .crown {
  position: absolute; left: 50%; top: 0; transform: translateX(-50%); z-index: 2;
  width: 0; height: 0;
  border-left: 8px solid transparent; border-right: 8px solid transparent;
  border-bottom: 6px solid #e8b23a;
}
.pcard .courtArt .hat {
  position: absolute; left: 50%; top: 1px; transform: translateX(-50%) rotate(-10deg); z-index: 2;
  width: 15px; height: 5px; border-radius: 4px 8px 2px 2px; background: #2f6e4f;
}
.pcard .courtArt .hair {
  position: absolute; left: 50%; top: 2px; transform: translateX(-50%); z-index: 1;
  width: 14px; height: 15px; border-radius: 7px 7px 4px 4px; background: #6b4423;
}
.pcard .courtArt .head {
  position: absolute; left: 50%; top: 5px; transform: translateX(-50%); z-index: 2;
  width: 11px; height: 11px; border-radius: 50%; background: #f3c99f;
  border: 1px solid rgba(0,0,0,.15); box-sizing: border-box;
}
.pcard .courtArt .beard {
  position: absolute; left: 50%; top: 11px; transform: translateX(-50%); z-index: 3;
  width: 9px; height: 5px; border-radius: 0 0 8px 8px; background: #8a6248;
}
.pcard .courtArt .robe {
  position: absolute; left: 50%; top: 16px; transform: translateX(-50%); z-index: 1;
  width: 22px; height: 20px; border-radius: 11px 11px 2px 2px;
}
.pcard .courtArt.rank-K .robe { background: linear-gradient(#c0392b, #8e2620); }
.pcard .courtArt.rank-Q .robe { background: linear-gradient(#7d4a9e, #5b3375); }
.pcard .courtArt.rank-J .robe { background: linear-gradient(#2f6e4f, #1f4d36); }
.pcard .courtArt .chest {
  position: absolute; left: 50%; top: 21px; transform: translateX(-50%); z-index: 3;
  font-size: 9px; line-height: 1; color: #ffe9b0; font-weight: bold;
}
.pcard.red { color: #cf3a2f; }
.pcard.knight { background: #eef0ec; color: #4a5068; }
.pcard.back {
  background: repeating-linear-gradient(45deg, #274e68 0 6px, #1d3d52 6px 12px);
  border: 3px solid #fdfcf7; box-sizing: border-box;
}

/* ---------- 筹码 ---------- */
.chip {
  width: 42px; height: 42px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center; flex: none;
  box-shadow: 0 3px 6px rgba(0,0,0,.45), inset 0 0 0 4px rgba(255,255,255,.55), inset 0 0 0 6px rgba(0,0,0,.12);
  border: 2px solid rgba(0,0,0,.35);
  box-sizing: border-box;
}
.chip .stars { font-size: 11px; letter-spacing: -1px; color: #222; font-weight: bold; }
.chip.white { background: #e9e7df; }
.chip.yellow { background: #f2c53d; }
.chip.orange { background: #ef8f2e; }
.chip.red { background: #d64541; }
.chip.red .stars { color: #fff; }
.chip.dark { filter: brightness(.45) saturate(.7); position: relative; }
.chip.takable { border: 2px solid #ffe9a0; }
.chipHover { transform: translateY(-4px) scale(1.06); }
.chip.mini { width: 30px; height: 30px; }
.chip.mini .stars { font-size: 8px; letter-spacing: 0; }
.chip.mini.dark::after {
  content: "🔒"; position: absolute; font-size: 10px; right: -2px; bottom: -2px;
}

/* ---------- 座位 ---------- */
.seat {
  position: absolute; width: 190px; margin-left: -95px; margin-top: -62px;
  background: rgba(6,22,16,.88); border: 2rpx solid #2e7a58; border-radius: 14rpx; padding: 10rpx;
  display: flex; flex-direction: column; gap: 8rpx; z-index: 10;
  box-shadow: 0 8px 22px rgba(0,0,0,.5);
}
.seatHead { display: flex; align-items: center; gap: 8rpx; }
.pname { font-weight: bold; font-size: 26rpx; color: #ffe9b0; flex: 1; overflow: hidden; white-space: nowrap; }
.badge { font-size: 20rpx; }
.eye {
  width: 52rpx; height: 52rpx; padding: 0; margin: 0;
  background: transparent; color: #9fc7b2;
  font-size: 30rpx;
  border-radius: 50%; flex: none; align-self: center;
  display: flex; align-items: center; justify-content: center;
}
.eye::after { border: none; }
.holeRow { display: flex; gap: 5px; justify-content: center; align-items: center; height: 50px; }
.chipLine { display: flex; gap: 5px; align-items: center; align-content: center; flex-wrap: wrap; justify-content: center; min-height: 30px; }
.rl { font-size: 20rpx; color: #8fb8a3; }
.returnBtn {
  background: rgba(214,69,65,.25); border: 2rpx solid #d64541; color: #ffb3ae;
  font-size: 20rpx; border-radius: 8rpx; padding: 2rpx 10rpx; line-height: 1.5; margin: 0 0 0 4rpx;
}
.returnBtn::after { border: none; }
.confirmBtn {
  align-self: center; font-size: 24rpx; padding: 4rpx 30rpx; border-radius: 12rpx;
  background: rgba(255,255,255,.08); border: 2rpx solid #2e7a58; color: #cfe8da;
  line-height: 1.7; margin: 0;
}
.confirmBtn::after { border: none; }
.confirmBtn.on { background: linear-gradient(#3d9b6d, #2a7a50); border-color: #7dd8a8; color: #fff; font-weight: bold; }
.confirmBtn.dis { opacity: .35; }
.msg { font-size: 20rpx; color: #a9cbbb; }

/* ---------- 手机竖排布局 ---------- */
.stackScroll { height: 100vh; box-sizing: border-box; }
.feltPanel {
  position: relative; margin: 10rpx 16rpx 0;
  background: radial-gradient(ellipse at 50% 30%, #2f8a5b, #1d5f3d 62%, #124529);
  border-radius: 32rpx; border: 8rpx solid #5a3d23;
  padding: 24rpx 16rpx 28rpx;
  display: flex; flex-direction: column; align-items: center; gap: 16rpx;
  box-shadow: inset 0 0 30px rgba(0,0,0,.5), 0 10rpx 30rpx rgba(0,0,0,.5);
  box-sizing: border-box;
}
.feltMarkM {
  color: rgba(255,233,176,.3); letter-spacing: 10rpx;
  font-size: 24rpx; font-weight: bold; margin-bottom: 4rpx;
}
.seatGrid { display: flex; flex-wrap: wrap; justify-content: space-between; padding: 20rpx 16rpx 10rpx; }
.seatM {
  width: 48.5%; box-sizing: border-box;
  background: rgba(6,22,16,.88); border: 2rpx solid #2e7a58; border-radius: 16rpx;
  padding: 12rpx; display: flex; flex-direction: column; gap: 8rpx;
  box-shadow: 0 6rpx 18rpx rgba(0,0,0,.5);
}
.seatM.me { border-color: #7dd8a8; box-shadow: 0 0 12rpx rgba(125,216,168,.4); }
.seatM .confirmBtn { align-self: center; margin-top: 4rpx; }
.stackFoot { height: 160rpx; }

/* ---------- 弹窗 ---------- */
.mroot {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0; display: none;
  align-items: center; justify-content: center;
  background: rgba(0,0,0,.65); z-index: 100; padding: 30rpx;
}
.mroot.show { display: flex; }
.mbox {
  background: linear-gradient(#173c2c, #0f2b1f);
  border: 2rpx solid #2e7a58; border-radius: 24rpx;
  width: 100%; max-height: 82vh;
  padding: 30rpx; box-sizing: border-box;
  box-shadow: 0 18rpx 60rpx rgba(0,0,0,.6);
}
.mtitle { color: #e8c15a; font-size: 32rpx; font-weight: bold; margin-bottom: 20rpx; }
.mtitle.priv { color: #ff9a90; }
.mbodyS { max-height: 56vh; }
.mbodyS rich-text { font-size: 26rpx; line-height: 1.9; color: #e3f0e8; }
.macts { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 24rpx; flex-wrap: wrap; }
.mbtn {
  background: linear-gradient(#3d9b6d, #2a7a50);
  color: #fff; border: none; border-radius: 14rpx;
  padding: 12rpx 36rpx; font-size: 27rpx; line-height: 1.5; margin: 0;
}
.mbtn::after { border: none; }
.mbtn.ghost { background: transparent; border: 2rpx solid #2e7a58; color: #bfe3d0; }
.mbtn.warn { background: linear-gradient(#c0524d, #a03a36); }

/* 私密选底牌 */
.privWarn { font-size: 26rpx; color: #e3f0e8; line-height: 1.8; margin-bottom: 16rpx; }
.otherWarn {
  background: rgba(214,69,65,.15); border: 2rpx solid #d64541; border-radius: 12rpx;
  padding: 12rpx; color: #ffd2cd; text-align: center; font-size: 26rpx; margin-bottom: 16rpx;
}
.pickRow { display: flex; flex-wrap: wrap; gap: 12rpx; justify-content: center; }
.pickCard { box-shadow: 0 4rpx 14rpx rgba(0,0,0,.5); }
.privWarn { font-size: 26rpx; color: #e3f0e8; line-height: 1.8; margin-bottom: 16rpx; }
.otherWarn {
  background: rgba(214,69,65,.15); border: 2rpx solid #d64541; border-radius: 12rpx;
  padding: 12rpx; color: #ffd2cd; text-align: center; font-size: 26rpx; margin-bottom: 16rpx;
}


/* ---------- 多边形筹码（3星三角/4星方形/5星五边/6星六边） ---------- */
.chip.s3 .stars, .chip .stars { font-size: 11px; font-weight: bold; color: #222; }
.chip.red .stars { color: #fff; }
.chip.mini .stars { font-size: 8px; }
.chip.mini.s3 .stars { margin-top: 7px; font-size: 7px; }

/* ---------- 自己的明牌底牌 ---------- */
.pcard.faceUp { border: 2rpx solid #7dd8a8; }
.myInfo { color: #ffe9b0 !important; text-align: center; }


/* ---------- 筹码内星点阵（3星三角/4星四方/5星五边/6星六边） ---------- */
.chip { position: relative; }
.chip .starDot {
  position: absolute; transform: translate(-50%, -50%);
  font-size: 11px; line-height: 1; color: #222; font-weight: bold;
}
.chip.red .starDot { color: #fff; }
.chip.mini .starDot { font-size: 7px; }


/* ---------- 星级配色（1~6 星颜色各异） ---------- */
.chip.st1 { background: #95a5a6; }
.chip.st2 { background: #4a90d9; }
.chip.st3 { background: #52b788; }
.chip.st4 { background: #f0c34e; }
.chip.st5 { background: #ef8f2e; }
.chip.st6 { background: #d64541; }
.chip.st1 .starDot, .chip.st4 .starDot { color: #222; }
.chip.st2 .starDot, .chip.st3 .starDot, .chip.st5 .starDot, .chip.st6 .starDot { color: #fff; }


/* ---------- tiny 完整卡面 ---------- */
.pcard.tiny .corner { top: 2px; left: 3px; }
.pcard.tiny .corner .rg { font-size: 8px; }
.pcard.tiny .corner .st { font-size: 7px; }
.pcard.tiny .corner.br { top: auto; left: auto; bottom: 2px; right: 3px; }
.pcard.tiny .pipI { font-size: 7px; }
.pcard.tiny .pipsArea.ace .pipI { font-size: 16px; }
.pcard.tiny .courtArt { transform: translate(-50%, -50%) scale(.72); }
.pcard.tiny.faceUp { width: 38px; height: 54px; }
.pcard.tiny.faceUp .pipI { font-size: 8px; }
.pcard.tiny.faceUp .pipsArea.ace .pipI { font-size: 18px; }
.pcard.tiny.faceUp .courtArt { transform: translate(-50%, -50%) scale(.8); }


/* ---------- 弹窗内完整卡面 ---------- */
.mcards { display: flex; gap: 16rpx; flex-wrap: wrap; padding: 10rpx 0; }
.mreveal .mcards { gap: 12rpx; }
.rlbl { font-size: 22rpx; color: #8fb8a3; margin-top: 10rpx; }
.pcard.hl2 { box-shadow: 0 0 0 6rpx #e8c15a, 0 3px 8px rgba(0,0,0,.4); }
.mbodyS.full { max-height: 40vh; }


/* ---------- 座位操作行（撤回+确认同排） ---------- */
.actionRow { display: flex; gap: 10rpx; margin-top: 4rpx; }
.actionRow .returnBtn { flex: 1; text-align: center; padding: 6rpx 0; font-size: 24rpx; margin: 0; border-radius: 8rpx; }
.actionRow .confirmBtn { flex: 1; margin: 0; }


/* ---------- 座位框紧凑化 ---------- */
.seatM { padding: 8rpx 12rpx; gap: 6rpx; }
.seatM .pname { font-size: 24rpx; }
.seatM .holeRow { height: 48px; gap: 4px; justify-content: center; align-items: center; }
.seatM .holeRow .eye { margin-left: 2px; }
.pcard.tiny { width: 30px; height: 44px; }
.pcard.tiny.faceUp { width: 32px; height: 46px; }
.pcard.tiny .pipI { font-size: 6px; }
.pcard.tiny .pipsArea.ace .pipI { font-size: 14px; }
.pcard.tiny .courtArt { transform: translate(-50%, -50%) scale(.62); }
.pcard.tiny .corner { top: 1px; left: 2px; }
.pcard.tiny .corner.br { top: auto; left: auto; bottom: 1px; right: 2px; }
.chip.mini { width: 26px; height: 26px; }
.chip.mini .starDot { font-size: 6px; }
.chipLine { gap: 5rpx; }
.actionRow .returnBtn, .actionRow .confirmBtn { font-size: 23rpx; padding: 4rpx 0; }
.seatM .msg { font-size: 20rpx; }

.r1hint { color: rgba(255,233,176,.8); font-size: 20rpx; margin-top: 8rpx; letter-spacing: 1rpx; }

/* ---------- 游戏内发言栏 ---------- */
.chatBar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 900;
  display: flex; align-items: center; gap: 16rpx;
  background: rgba(6,22,16,.94);
  border-top: 2rpx solid rgba(46,122,88,.7);
  padding: 14rpx 24rpx calc(14rpx + env(safe-area-inset-bottom));
}
.chatBar.hide { display: none; }
.chatInput {
  flex: 1; height: 68rpx; line-height: 68rpx; min-height: 68rpx;
  background: rgba(255,255,255,.08); border: 2rpx solid #2e7a58; border-radius: 34rpx;
  color: #e8f5ee; font-size: 26rpx; padding: 0 28rpx; box-sizing: border-box;
}
.chatSend {
  flex: none; margin: 0; width: 132rpx; height: 68rpx; line-height: 68rpx;
  font-size: 26rpx; padding: 0; border-radius: 34rpx;
  background: #3d9b6d; color: #fff; border: 2rpx solid #57c48f;
}
/* 座位内发言气泡：比系统提示更醒目 */
.msg { font-size: 20rpx; color: #a9cbbb; }
.msg.chat {
  display: block; margin-top: 6rpx; padding: 8rpx 16rpx;
  background: rgba(232,193,90,.12); border: 2rpx dashed rgba(232,193,90,.5);
  border-radius: 10rpx; color: #ffe9b0; font-size: 22rpx; line-height: 1.5;
  word-break: break-all;
}

/* ---------- 整局结束操作栏 ---------- */
.overBar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 999;
  display: none;
  background: rgba(6,22,16,.96);
  border-top: 2rpx solid #2e7a58;
  box-shadow: 0 -8px 24px rgba(0,0,0,.5);
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
}
.overBar.show { display: block; }
.overTitle { text-align: center; color: #ffe9b0; font-size: 30rpx; font-weight: bold; margin-bottom: 16rpx; }
.overBtns { display: flex; gap: 20rpx; }
.overBtn {
  flex: 1; margin: 0; font-size: 28rpx; line-height: 2.2; border-radius: 14rpx;
}
.overBtn.primary {
  background: #3d9b6d; color: #fff; border: 2rpx solid #57c48f;
}
.overBtn.ghost {
  background: rgba(214,69,65,.18); color: #ffb3ae; border: 2rpx solid #d64541;
}
.overBtn::after { border: none; }

/* ---------- 摊牌结果板（全员同屏） ---------- */
.sdBoard { width: 92%; max-width: 680rpx; }
.sdVerdict { margin: 8rpx 0 4rpx; padding: 12rpx 16rpx; border-radius: 12rpx; font-size: 24rpx; line-height: 1.5; }
.sdVerdict.ok { background: rgba(61,155,109,.22); color: #8fe6b4; border: 2rpx solid #57c48f; }
.sdVerdict.bad { background: rgba(214,69,65,.22); color: #ffb3ae; border: 2rpx solid #d64541; }
.sdList { max-height: 56vh; margin: 8rpx 0 4rpx; }
.sdRow {
  background: rgba(20,50,38,.55); border: 2rpx solid rgba(46,122,88,.45);
  border-radius: 14rpx; padding: 12rpx 16rpx; margin-bottom: 12rpx;
}
.sdHead { display: flex; align-items: center; gap: 10rpx; }
.sdSeq {
  flex: none; width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center;
  border-radius: 50%; background: #2e7a58; color: #fff; font-size: 24rpx; font-weight: bold;
}
.sdStar {
  flex: none; padding: 4rpx 12rpx; border-radius: 10rpx; font-size: 22rpx; font-weight: bold;
  background: rgba(200,53,46,.25); color: #ffb3ae; border: 2rpx solid #c8352e;
}
.sdName { flex: 1; min-width: 0; font-size: 26rpx; color: #ffe9b0; font-weight: bold; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sdHand { color: #e8c15a; font-size: 23rpx; margin-left: 8rpx; font-weight: normal; }
.sdCardsRow { display: flex; align-items: center; gap: 4rpx; margin-top: 8rpx; }
.sdLbl { flex: none; width: 54rpx; color: #8fb8a3; font-size: 20rpx; }
.sdMark { flex: none; width: 48rpx; height: 48rpx; line-height: 48rpx; text-align: center; border-radius: 50%; font-size: 30rpx; font-weight: bold; }
.sdMark.ok { background: rgba(61,155,109,.3); color: #8fe6b4; border: 3rpx solid #57c48f; }
.sdMark.bad { background: rgba(214,69,65,.28); color: #ffb3ae; border: 3rpx solid #d64541; }
.sdHint { text-align: center; color: #8fb8a3; font-size: 21rpx; padding: 4rpx 0; }
.sdDoneRow { display: flex; justify-content: center; align-items: center; padding: 8rpx 0 4rpx; min-height: 70rpx; }
.sdDone {
  margin: 0; width: 340rpx; font-size: 30rpx; font-weight: bold; line-height: 2.1;
  border-radius: 14rpx; background: #3d9b6d; color: #fff; border: 2rpx solid #57c48f;
  box-shadow: 0 4rpx 12rpx rgba(61,155,109,.4);
}
.sdDone::after { border: none; }
.sdWait { color: #8fb8a3; font-size: 24rpx; }
