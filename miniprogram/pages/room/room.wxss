.wrap { padding: 30rpx; }
.panel {
  background: rgba(10,30,22,.85);
  border: 2rpx solid #2e7a58;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 12rpx 40rpx rgba(0,0,0,.45);
}
.secTitle {
  font-size: 28rpx; color: #e8c15a; font-weight: bold;
  border-left: 8rpx solid #e8c15a; padding-left: 16rpx;
  margin: 20rpx 0 16rpx;
}
.codeBox {
  display: flex; align-items: center; justify-content: center; gap: 20rpx;
  background: rgba(0,0,0,.3); border-radius: 16rpx; padding: 20rpx;
}
.code { font-size: 72rpx; letter-spacing: 14rpx; color: #ffe9b0; font-weight: bold; }
.copyBtn {
  background: rgba(255,255,255,.1); border: 2rpx solid #2e7a58; color: #cfe8da;
  font-size: 24rpx; padding: 8rpx 20rpx; border-radius: 10rpx; line-height: 1.5;
}
.copyBtn::after { border: none; }
.hint { text-align: center; color: #9fc7b2; font-size: 24rpx; margin-top: 16rpx; }
.shareTip { text-align: center; color: #6f9c88; font-size: 22rpx; margin-top: 8rpx; }
.codeInput {
  background: rgba(255,255,255,.08); border: 2rpx solid #2e7a58; color: #fff;
  padding: 20rpx; border-radius: 14rpx; font-size: 44rpx; letter-spacing: 14rpx;
  text-align: center; margin-bottom: 20rpx;
}
.plist { display: flex; flex-direction: column; gap: 10rpx; }
.pitem {
  display: flex; align-items: center; gap: 14rpx;
  background: rgba(255,255,255,.05); border-radius: 12rpx; padding: 14rpx 20rpx;
}
.pitem.me { border: 2rpx solid #7dd8a8; }
.pseat { color: #e8c15a; font-size: 24rpx; width: 70rpx; }
.pname { color: #eef3ef; font-size: 27rpx; flex: 1; }
.hostTag { font-size: 20rpx; color: #7fb2ff; border: 2rpx solid #7fb2ff; border-radius: 6rpx; padding: 2rpx 10rpx; }

/* ---- 标准/进阶模式选择 ---- */
.segRow { display: flex; gap: 14rpx; }
.opt {
  flex: 1;
  background: rgba(255,255,255,.06);
  border: 2rpx solid rgba(46,122,88,.8);
  color: #d7eade;
  padding: 14rpx 0;
  border-radius: 14rpx;
  font-size: 27rpx;
  line-height: 1.4;
  margin: 0;
}
.opt::after { border: none; }
.opt.sel { background: linear-gradient(#3d9b6d, #2a7a50); border-color: #7dd8a8; color: #fff; font-weight: bold; }
.opt.dis { opacity: .75; }
.modeHint { font-size: 22rpx; color: #7ba28e; margin-top: 12rpx; text-align: center; }

/* ---- 自定义：挑战牌勾选列表 ---- */
.chalList {
  max-height: 480rpx;
  margin-top: 6rpx;
  border: 2rpx solid rgba(46,122,88,.5);
  border-radius: 14rpx;
  background: rgba(0,0,0,.22);
}
.chalItem {
  display: flex; align-items: flex-start; gap: 14rpx;
  padding: 16rpx 18rpx;
  border-bottom: 2rpx solid rgba(46,122,88,.28);
}
.chalItem:last-child { border-bottom: none; }
.chalItem.on { background: rgba(61,155,109,.16); }
.cbox {
  flex: none;
  width: 38rpx; height: 38rpx; margin-top: 4rpx;
  border: 3rpx solid #2e7a58; border-radius: 8rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; font-weight: bold; color: #7dd8a8;
  box-sizing: border-box;
}
.chalItem.on .cbox { background: #2a7a50; border-color: #7dd8a8; color: #fff; }
.cinfo { flex: 1; min-width: 0; }
.cname { font-size: 26rpx; color: #e8c15a; font-weight: bold; }
.chalItem.on .cname { color: #ffe9b0; }
.ctext { font-size: 21rpx; color: #9fc7b2; line-height: 1.5; margin-top: 4rpx; }

.startBtn { display: block; margin: 30rpx auto 0; width: 80%; }
.error { color: #ff9a90; font-size: 24rpx; margin-top: 16rpx; text-align: center; }
.backBtn { display: block; margin: 24rpx auto 0; width: 60%; }
