<view class="wrap">
  <view class="panel">
    <!-- 创建方 -->
    <block wx:if="{{action==='create' && roomId}}">
      <view class="secTitle">房间已创建</view>
      <view class="codeBox">
        <text class="code">{{roomId}}</text>
        <button class="copyBtn" catchtap="copyCode">复制</button>
      </view>
      <view class="hint">把房间号发给朋友，或在"加入房间"中输入</view>
      <view class="shareTip">也可以直接点右上角 ··· 转发卡片给朋友</view>
    </block>

    <!-- 加入方 -->
    <block wx:if="{{action==='join' && !roomId}}">
      <view class="secTitle">加入房间</view>
      <input class="codeInput" type="number" maxlength="6" placeholder="输入 6 位房间号"
        value="{{joinCode}}" bindinput="onCode" />
      <button class="btn" bindtap="doJoin" loading="{{loading}}">加入</button>

      <!-- 可加入的房间（实时刷新，点卡片直接进） -->
      <view class="listHead">
        <text class="listTitle">可加入的房间</text>
        <text class="refresh" bindtap="loadRooms">刷新</text>
      </view>
      <view wx:if="{{roomList.length}}" class="roomList">
        <view wx:for="{{roomList}}" wx:key="code" class="roomItem"
          bindtap="onPickRoom" data-code="{{item.code}}">
          <view class="rLeft">
            <text class="rCode">{{item.code}}</text>
            <text class="rHost">{{item.hostName}} 的房间</text>
          </view>
          <view class="rRight">
            <text class="rCount">{{item.count}}/{{item.max}} 人</text>
            <text class="rJoin {{item.count>=item.max?'full':''}}">{{item.count>=item.max?'已满':'加入'}}</text>
          </view>
        </view>
      </view>
      <view wx:else class="roomEmpty">{{listLoading ? '正在查找房间…' : '暂无可用房间，可自己创建一个'}}</view>
    </block>

    <!-- 加入成功等待中 -->
    <block wx:if="{{action==='join' && roomId}}">
      <view class="secTitle">已加入房间</view>
      <view class="codeBox"><text class="code">{{roomId}}</text></view>
      <view class="hint">等待房主开始对局…</view>
    </block>

    <view class="secTitle">帮众（{{players.length}}/{{maxPlayers}}）</view>
    <view class="plist">
      <view wx:for="{{players}}" wx:key="id" class="pitem {{item.seat===mySeat?'me':''}}">
        <text class="pseat">{{item.seat+1}}号</text>
        <text class="pname">{{item.name}}</text>
        <text wx:if="{{item.seat===0}}" class="hostTag">房主</text>
      </view>
    </view>

    <!-- 游戏模式：房主切换，全员实时可见 -->
    <block wx:if="{{roomId}}">
      <view class="secTitle">游戏模式</view>
      <view class="segRow">
        <button class="opt {{gameMode==='standard'?'sel':''}} {{isHost?'':'dis'}}"
          bindtap="pickMode" data-v="standard">标准</button>
        <button class="opt {{gameMode==='advanced'?'sel':''}} {{isHost?'':'dis'}}"
          bindtap="pickMode" data-v="advanced">进阶</button>
        <button class="opt {{gameMode==='custom'?'sel':''}} {{isHost?'':'dis'}}"
          bindtap="pickMode" data-v="custom">自定义</button>
      </view>
      <view class="modeHint">{{gameMode==='advanced'?'启用全部挑战牌与专家牌（各 10 张），更刺激':(gameMode==='custom'?'从下方勾选本次要启用的挑战牌玩法':'第一次玩建议标准模式')}}</view>

      <!-- 自定义：挑战牌勾选列表（多选，房主操作，全员同步可见） -->
      <block wx:if="{{gameMode==='custom'}}">
        <scroll-view scroll-y class="chalList">
          <view wx:for="{{chalList}}" wx:key="id"
            class="chalItem {{item.checked?'on':''}}"
            bindtap="toggleChal" data-id="{{item.id}}">
            <view class="cbox">{{item.checked?'✓':''}}</view>
            <view class="cinfo">
              <view class="cname">{{item.name}}</view>
              <view class="ctext">{{item.text}}</view>
            </view>
          </view>
        </scroll-view>
        <view class="modeHint" wx:if="{{isHost}}">已选 {{customCount}} 张 · 勾选的玩法将同时生效（至少选 1 张）</view>
      </block>
    </block>

    <button wx:if="{{isHost}}" class="btn startBtn" bindtap="startGame"
      disabled="{{players.length<minPlayers}}">开始对局{{players.length<minPlayers?'（至少 '+minPlayers+' 人）':''}}</button>

    <view wx:if="{{error}}" class="error">{{error}}</view>
    <view wx:if="{{status==='over'}}" class="error">对局已结束</view>
  </view>

  <button class="btn ghost backBtn" bindtap="backHome">退出房间</button>
</view>
